[Unit]
Description=Hanjari daily close (data check, monitor, retrain, gate, deploy, cleanup)
OnFailure=hanjari-fail@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/hanjari-ml/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/hanjari-ml/.venv/bin/python daily.py
# 전환 성공 때만 재시작. 실패 시 표식을 남겨 다음 실행에서 재시도하고 OnFailure로 알린다.
ExecStartPost=+/bin/sh -c 'if [ -f /home/ubuntu/hanjari-ml/reports/restart_required ]; then /bin/systemctl try-restart hanjari-web && /bin/rm -f /home/ubuntu/hanjari-ml/reports/restart_required; fi'
# 수집기를 지키는 제한: 메모리 500M 부터 느려지고 650M 에서 이 작업만 종료, CPU 1코어, 최저 우선순위
MemoryHigh=500M
MemoryMax=650M
CPUQuota=100%
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=4h
